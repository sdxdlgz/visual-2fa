# SQLite (local development / Docker)
DATABASE_URL=file:./data/visual-2fa.db

# Docker Compose only: host port and GHCR image tag.
VISUAL_2FA_PORT=28473
VISUAL_2FA_TAG=latest

# PostgreSQL (Vercel / serverless), use a pooled TLS connection URL instead:
# DATABASE_URL=postgresql://user:password@host:5432/visual2fa?sslmode=require

# Public canonical origin used for strict same-origin checks behind proxies.
# APP_ORIGIN=https://2fa.example.com

# Optional session lifetime in days (1-30).
SESSION_DAYS=7
